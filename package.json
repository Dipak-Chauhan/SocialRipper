{
  "name": "social-ripper",
  "version": "1.0.0",
  "private": true,
  "description": "A local utility for downloading public social media.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "ffmpeg-static": "5.3.0",
    "youtube-dl-exec": "3.1.9"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.9": true,
    "ffmpeg-static@5.3.0": true
  }
}
